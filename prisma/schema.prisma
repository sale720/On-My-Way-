// Phase 1 — Technical foundation: identity, sessions, RBAC, tenant (salon) isolation, audit.
// Marketplace/booking models are introduced in Phase 2 (see docs/DECISIONS.md, D-004).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Locale {
  ar
  en
}

// Platform-wide roles. Salon-scoped roles live on SalonMembership.
enum PlatformRole {
  CUSTOMER
  PROVIDER
  SUPPORT_AGENT
  PLATFORM_ADMIN
}

enum SalonStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum SalonRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model User {
  id          String     @id @default(cuid())
  phone       String     @unique // E.164, e.g. +9665XXXXXXXX
  name        String?
  locale      Locale     @default(ar)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles       PlatformRoleAssignment[] @relation("RoleHolder")
  rolesGiven  PlatformRoleAssignment[] @relation("RoleGranter")
  sessions    Session[]
  memberships SalonMembership[]
  auditLogs   AuditLog[]
  salonsMade  Salon[]
}

model PlatformRoleAssignment {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation("RoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role        PlatformRole
  grantedById String?
  grantedBy   User?        @relation("RoleGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@unique([userId, role])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // sha256 of the opaque cookie token; raw token is never stored
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String // HMAC-SHA256(AUTH_SECRET, phone:code)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([requestIp, createdAt])
}

model Salon {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  status      SalonStatus @default(PENDING_REVIEW)
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  memberships SalonMembership[]
  auditLogs   AuditLog[]
}

model SalonMembership {
  id        String           @id @default(cuid())
  salonId   String
  salon     Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SalonRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([salonId, userId])
  @@index([userId])
}

// Append-only record of sensitive actions (who, what, when, why).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // null = system (e.g. CLI bootstrap)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  salonId    String?
  salon      Salon?   @relation(fields: [salonId], references: [id], onDelete: SetNull)
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([salonId, createdAt])
  @@index([createdAt])
}
