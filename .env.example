# Copy to .env and fill in. Never commit real secrets.
# APP_ENV: development | test | production
APP_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# At least 32 random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=""
# SMS provider for OTP delivery.
#   sandbox = stores messages in the DB and shows them at /dev/sms (testing; nothing is sent)
#   console = prints OTP to server log (development only)
#   memory  = in-process capture (automated tests only)
# Production rejects all three; a real provider adapter must be configured (see docs/INTEGRATIONS.md).
SMS_PROVIDER=sandbox
# Payments: off = cash only; sandbox = simulated gateway for all online methods (no real money). Production rejects sandbox.
PAYMENT_MODE=sandbox
